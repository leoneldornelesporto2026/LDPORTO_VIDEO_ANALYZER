{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LDPORTO Narrative Handoff 1.0",
  "type": "object",
  "required": ["schema_version", "contract", "source_sha256", "duration", "artifact_refs", "status", "requires_curator_review", "publication_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract": {"const": "ldporto.narrative_handoff"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "duration": {"type": "number", "exclusiveMinimum": 0},
    "status": {"enum": ["SECOND_CURATION_READY", "SECOND_CURATION_PARTIAL", "ANALYZER_REPAIR_REQUIRED"]},
    "artifact_refs": {"type": "object", "required": ["units", "graph", "qa", "sequences", "titles", "quality", "repair"]},
    "requires_curator_review": {"const": true},
    "preview_approved": {"const": false},
    "publication_ready": {"const": false},
    "no_final_render": {"const": true}
  }
}
