        {
          "segment_id": "SEG_00483",
          "start": 1114.08,
          "end": 1115.22,
          "speaker": "SPEAKER_02",
          "text": "Que participou do BBB, inclusive."
        },
        {
          "segment_id": "SEG_00484",
          "start": 1115.44,
          "end": 1115.78,
          "speaker": "SPEAKER_02",
          "text": "Sim."
        },
        {
          "segment_id": "SEG_00485",
          "start": 1115.88,
          "end": 1116.98,
          "speaker": "SPEAKER_02",
          "text": "A gente é muito amigo."
        },
        {
          "segment_id": "SEG_00486",
          "start": 1117.46,
          "end": 1117.82,
          "speaker": null,
          "text": "E"
        },
        {
          "segment_id": "SEG_00487",
          "start": 1117.82,
          "end": 1119.24,
          "speaker": "SPEAKER_02",
          "text": "a gente já fez coisas juntos e tal."
        },
        {
          "segment_id": "SEG_00488",
          "start": 1119.28,
          "end": 1122.56,
          "speaker": "SPEAKER_02",
          "text": "Mas a gente sempre falava de fazer alguma coisa mais oficial, assim, juntos."
        },
        {
          "segment_id": "SEG_00489",
          "start": 1122.72,
          "end": 1126.54,
          "speaker": "SPEAKER_02",
          "text": "E o nosso público também esperava, assim, tinha essa expectativa."
        },
        {
          "segment_id": "SEG_00490",
          "start": 1126.76,
          "end": 1128.82,
          "speaker": "SPEAKER_02",
          "text": "E aí, eu pensei, se eu fizer com ele, né?"
        },
        {
          "segment_id": "SEG_00491",
          "start": 1128.82,
          "end": 1129.96,
          "speaker": "SPEAKER_02",
          "text": "Aí chamei ele, ele adorou a ideia."
        },
        {
          "segment_id": "SEG_00492",
          "start": 1130.44,
          "end": 1132.3,
          "speaker": "SPEAKER_02",
          "text": "E aí, a gente criou a live dos anjos."
        },
        {
          "segment_id": "SEG_00493",
          "start": 1133.5,
          "end": 1133.82,
          "speaker": null,
          "text": "Dos"
        },
        {
          "segment_id": "SEG_00494",
          "start": 1133.82,
          "end": 1135.26,
          "speaker": "SPEAKER_02",
          "text": "anjos, por causa do BBB, né?"
        },
        {
          "segment_id": "SEG_00495",
          "start": 1135.3,
          "end": 1137.22,
          "speaker": "SPEAKER_02",
          "text": "Que é o almoço do anjo, o presente do anjo."
        },
        {
          "segment_id": "SEG_00496",
          "start": 1137.3,
          "end": 1139.46,
          "speaker": "SPEAKER_02",
          "text": "Porque tinha gente que entrava na live e falava assim..."
        },
        {
          "segment_id": "SEG_00497",
          "start": 1139.46,
          "end": 1141.32,
          "speaker": "SPEAKER_02",
          "text": "Gente, achei que era uma live bíblica."
        },
        {
          "segment_id": "SEG_00498",
          "start": 1141.3600000000001,
          "end": 1141.68,
          "speaker": "SPEAKER_02",
          "text": "Da"
        },
        {
          "segment_id": "SEG_00499",
          "start": 1141.68,
          "end": 1142.12,
          "speaker": null,
          "text": "igreja!"
        },
        {
          "segment_id": "SEG_00500",
          "start": 1143.62,
          "end": 1143.94,
          "speaker": null,
          "text": "E"
        },
        {
          "segment_id": "SEG_00501",
          "start": 1143.94,
          "end": 1144.44,
          "speaker": "SPEAKER_02",
          "text": "aí, deu..."
        },
        {
          "segment_id": "SEG_00502",
          "start": 1144.44,
          "end": 1147.04,
          "speaker": "SPEAKER_02",
          "text": "Pela porcentagem dos evangélicos da plataforma."
        },
        {
          "segment_id": "SEG_00503",
          "start": 1147.46,
          "end": 1149.1399999999999,
          "speaker": "SPEAKER_02",
          "text": "E deu super certo, assim."
        },
        {
          "segment_id": "SEG_00504",
          "start": 1149.2,
          "end": 1149.8,
          "speaker": "SPEAKER_02",
          "text": "Foi muito legal."
        },
        {
          "segment_id": "SEG_00505",
          "start": 1149.88,
          "end": 1150.9,
          "speaker": "SPEAKER_02",
          "text": "E a gente fazia toda semana."
        },
        {
          "segment_id": "SEG_00506",
          "start": 1151.06,
          "end": 1152.2,
          "speaker": "SPEAKER_02",
          "text": "Então, era um resumão da semana."
        },
        {
          "segment_id": "SEG_00507",
          "start": 1152.98,
          "end": 1155.6,
          "speaker": "SPEAKER_02",
          "text": "Trazia fatos que estavam acontecendo naquela hora também e tal."
        },
        {
          "segment_id": "SEG_00508",
          "start": 1155.76,
          "end": 1156.94,
          "speaker": "SPEAKER_02",
          "text": "E foi muito legal."
        },
        {
          "segment_id": "SEG_00509",
          "start": 1156.94,
          "end": 1160.98,
          "speaker": "SPEAKER_02",
          "text": "Foi muito legal, porque acabou que a gente criou meio que uma comunidade ali."
