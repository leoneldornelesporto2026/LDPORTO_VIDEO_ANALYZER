          "narrative_role": "SETUP",
          "summary": "Descrição do uso de instrumentos de navegação durante o voo.",
          "context_required": [],
          "previous_story_position": 4,
          "next_story_relationship": {
            "story_id": "SEM_STORY_42f6d46a1e32c91c",
            "relationship": "CONTINUES"
          },
          "suggested_opening": "Quando eles decolaram, tanto os instrumentos do comandante, quanto do primeiro oficial, estavam sintonizados na frequência de VOR de Marabá.",
          "suggested_ending": "Descrição do uso de instrumentos de navegação durante o voo.",
          "new_information": "Descrição do uso de instrumentos de navegação durante o voo",
          "supporting_quotes": [
            {
              "segment_id": "SEG_00133",
              "quote": "Quando eles decolaram, tanto os instrumentos do comandante, quanto do primeiro oficial, estavam sintonizados na frequência de VOR de Marabá."
            },
            {
              "segment_id": "SEG_00134",
              "quote": "Então, a indicação das agulhas dos RMI, que é esse instrumento aí que você está vendo, estavam apontadas para trás."
            },
            {
              "segment_id": "SEG_00135",
              "quote": "Com 15 minutos de voo, por volta das 17h50, o Zilli sintonizou os instrumentos dele na frequência de Belém."
            },
            {
              "segment_id": "SEG_00136",
              "quote": "Ao invés da agulha do ADF apontar para frente, ela começou a girar, já que o avião não estava encontrando aquelas antenas, porque eles tinham se afastado de Belém e não ido em direção a Belém."
            },
            {
              "segment_id": "SEG_00137",
              "quote": "O problema é que era comum as antenas da Amazônia não terem um alcance muito longo, E ele imaginou que ainda não estava na distância suficiente para entrar na área das antenas de Belém."
            },
            {
              "segment_id": "SEG_00138",
              "quote": "E aí, nem se preocuparam com isso."
            },
            {
              "segment_id": "SEG_00139",
              "quote": "Só que eles não se tocaram de um detalhe."
            }
          ],
          "missing_information": [],
