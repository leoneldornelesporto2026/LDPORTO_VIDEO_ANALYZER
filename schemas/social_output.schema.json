{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LDPORTO Social Output Plan",
  "type": "object",
  "required": ["schema_version", "mode", "selected_aspect_ratio", "available_aspect_ratios", "stories"],
  "properties": {
    "schema_version": {"type": "string"},
    "mode": {"const": "multiple_independent_stories"},
    "selected_aspect_ratio": {"enum": ["9:16", "4:5", "1:1", "16:9"]},
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["story_id", "candidate_id", "start", "end", "duration", "category", "title", "caption_plan", "aspect_ratio"],
        "properties": {
          "story_id": {"type": "string"},
          "candidate_id": {"type": "string"},
          "start": {"type": "number"},
          "end": {"type": "number"},
          "duration": {"type": "number", "minimum": 0},
          "category": {"type": "string"},
          "title": {"type": "string"},
          "aspect_ratio": {"enum": ["9:16", "4:5", "1:1", "16:9"]},
          "caption_plan": {"type": "object"}
        }
      }
    }
  }
}
